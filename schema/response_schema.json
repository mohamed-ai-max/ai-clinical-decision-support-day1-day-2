{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Grounded Clinical Response",
  "type": "object",
  "required": ["status", "answer", "evidence", "citations", "confidence"],
  "properties": {
    "status": {"type": "string", "enum": ["grounded", "abstain"]},
    "answer": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_name", "page_number"],
        "properties": {
          "document_name": {"type": "string"},
          "page_number": {"type": ["integer", "string"]},
          "chunk_id": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "string", "enum": ["confident", "uncertain", "insufficient"]},
    "top_score": {"type": "number"}
  },
  "additionalProperties": false
}
